#!/bin/bash

NODE=""
NPM=""
for p in \
    /var/apps/nodejs_v22/target/bin/node \
    /var/apps/nodejs_v20/target/bin/node \
    /var/apps/nodejs_v18/target/bin/node \
    /usr/local/bin/node \
    /usr/bin/node; do
    if [ -x "$p" ]; then
        NODE="$p"
        NPM="$(dirname "$p")/npm"
        break
    fi
done
[ -z "$NODE" ] && { NODE="node"; NPM="npm"; }

cd ${TRIM_APPDEST}/server

if [ -d "node_modules" ]; then
    exit 0
fi

echo "正在更新依赖..." > ${TRIM_TEMP_LOGFILE}
echo "node: $($NODE -v)" >> ${TRIM_TEMP_LOGFILE}

$NPM install --production >> ${TRIM_TEMP_LOGFILE} 2>&1
if [ $? -eq 0 ]; then
    exit 0
fi

$NPM install --production --registry=https://registry.npmmirror.com >> ${TRIM_TEMP_LOGFILE} 2>&1
if [ $? -eq 0 ]; then
    exit 0
fi

echo "npm install 全部失败，请在开发机预先安装依赖后重新打包" >> ${TRIM_TEMP_LOGFILE}
exit 1
